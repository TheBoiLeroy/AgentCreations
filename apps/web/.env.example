# Optional cloud drafts. Use apps/web/.env.local for Next.js development.
# Use the project's anon/publishable key, NEVER a service-role key.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Optional Jev enhancement. Both are required; otherwise Jev uses rules only.
# These are server-only variables: do not add NEXT_PUBLIC_ prefixes.
JEV_API_KEY=
JEV_MODEL=

# Optional skills.sh catalog sync (stage-one backend only).
# Production: enable Vercel OIDC; Vercel supplies VERCEL_OIDC_TOKEN at runtime.
# Do not paste the token into browser inputs or commit it. Local tokens expire.
# Also apply 202610180002_skill_catalog.sql and provision a non-anonymous
# maintainer membership through your database operator. See docs/skill-catalog.md.
# No daily scheduler is enabled by these settings.
