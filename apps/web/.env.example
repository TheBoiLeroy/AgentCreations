# Copy to apps/web/.env.local. Every value here is server-only: never add NEXT_PUBLIC_.

# Storage. Empty means a local Turso (libSQL) file at <repo>/.data/agent-creations.db,
# created and migrated automatically. Point at Turso Cloud later with:
#   TURSO_DATABASE_URL=libsql://<db>-<org>.turso.io
#   TURSO_AUTH_TOKEN=<token from `turso db tokens create <db>`>
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# GitHub sign-in for profiles and setups. Create an OAuth app at
# https://github.com/settings/developers with the callback URL
# <APP_URL>/auth/callback (locally: http://127.0.0.1:3000/auth/callback).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# The site's public origin. Required in production so the OAuth redirect can't be steered by a Host header.
APP_URL=
# Under `next dev` on your own machine, /me also offers a dev sign-in by handle. Set to 0 to hide it.
ALLOW_DEV_SIGN_IN=

# Optional Jev model pass (Jev by TypeSafe, https://docs.typesafe.ai). Without a key Jev uses rules only.
# JEV_API_KEY: a TypeSafe key (starts with apikey_) from https://console.typesafe.ai/keys.
# TYPESAFE_API_KEY is accepted too. JEV_MODEL: lowercase, e.g. jev-1.14.0; default jev-latest.
JEV_API_KEY=
JEV_MODEL=

# Optional skills.sh catalog sync (maintainers only). On Vercel, enable OIDC and
# VERCEL_OIDC_TOKEN is supplied at runtime. Add a maintainer with:
#   corepack pnpm db maintainer <handle>
# Nothing runs on a schedule. See docs/skill-catalog.md.
